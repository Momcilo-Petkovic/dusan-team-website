# Settings for `docker compose up`. Copy this file to .env and fill in what you need.
# Everything is optional: without Cloudinary you can't upload images, and without
# Gmail contact messages are only stored in the database.

# Admin panel login (if empty, a password is generated: see `docker compose logs backend`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudinary (image hosting), from https://console.cloudinary.com
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Gmail for the contact form (use a Gmail app password)
MAIL_USERNAME=
MAIL_PASSWORD=
